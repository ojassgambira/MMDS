{
  "name": "mmds-research-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node tests/check-build.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "vitest run",
    "test:browser": "playwright test",
    "lint": "prettier --check src tests vite.config.js playwright.config.js index.html package.json"
  },
  "dependencies": {
    "plotly.js-cartesian-dist-min": "4.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "prettier": "3.6.2"
  }
}
